APP_NAME=Corporate Data Chat
ENVIRONMENT=local
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

APP_DATA_DIR=.data
METADATA_DB_PATH=.data/app_metadata.db
PYTHON_WORK_DIR=.data/python-work

# Optional comma-separated allowlist. Leave empty to allow any local file path.
ALLOWED_DATA_ROOTS=

VLLM_BASE_URL=http://localhost:8000/v1
OPENAI_API_BASE=
OPENAI_API_KEY=local-key
MODEL_NAME=qwen3-coder-next
MODEL_TEMPERATURE=0.1
MODEL_MAX_TOKENS=4096
MODEL_TIMEOUT_SECONDS=120
MODEL_RETRIES=2

SQL_TIMEOUT_SECONDS=30
SQL_RESULT_ROW_LIMIT=1000
SQL_PREVIEW_ROW_LIMIT=100
PYTHON_TIMEOUT_SECONDS=20
PYTHON_MAX_CODE_CHARS=12000
